{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "recovered",
        "failed"
      ]
    },
    "restoredVersion": {
      "type": "string",
      "minLength": 1
    },
    "attempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "finishedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "outcome",
    "attempts",
    "finishedAt"
  ],
  "additionalProperties": {},
  "title": "coforge-installer recovery report"
}
