# Caddy owns the only public entry: trusted HTTPS on 443. Port 80 serves
# nothing but Caddy's automatic redirect to the same URL over HTTPS.
{
	admin off

	# Agent credentials must never reach a log (task #559). The site `log` directive only filters
	# access logs; when an upstream refuses a connection, Caddy logs the whole request — headers
	# included, `X-Coforge-Agent-Api-Key` among them — through the default (error) logger, and only
	# Authorization and Cookie are redacted for it. The same field is deleted there.
	log default {
		format filter {
			wrap json
			fields {
				request>headers>X-Coforge-Agent-Api-Key delete
			}
		}
	}
}

coforge.cn {
	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 5
		}
		# Agent credentials must never reach the log (task #559): Caddy already
		# redacts Authorization, but X-Coforge-Agent-Api-Key is ours to hide.
		format filter {
			wrap json
			fields {
				request>headers>X-Coforge-Agent-Api-Key delete
			}
		}
	}

	# HSTS rides only on HTTPS responses; the port-80 redirect is a separate
	# server and never carries it. max-age ramps toward HSTS preload
	# (https://hstspreload.org/#deployment-recommendations): 300, then
	# 604800, then 2592000, waiting out each stage before the next.
	header Strict-Transport-Security "max-age=300; includeSubDomains"

	# Realtime transport stays standalone Centrifugo; everything else is the
	# web application. Route order: explicit realtime prefixes first.
	@realtime path /connection/*
	handle @realtime {
		reverse_proxy centrifugo:8000
	}

	# Cloud desktops. The browser stays on this HTTPS site. Web confirms the
	# signed-in user owns that cloud computer, then this proxies the page and
	# its websocket to the Swarm host. The upstream is internal HTTP; it is not
	# a public listener. {$COFORGE_DESKTOP_UPSTREAM} is the host:port from Compose.
	@desktop path /desktop /desktop/*
	handle @desktop {
		forward_auth web:3000 {
			uri /api/internal/desktop-authorize
			header_up X-Desktop-Path {http.request.uri.path}
		}
		reverse_proxy {$COFORGE_DESKTOP_UPSTREAM} {
			flush_interval -1
		}
	}

	# The web application compresses nothing itself, so HTML, JS, CSS and
	# Server Function JSON are compressed here (zstd, else gzip). The realtime
	# route above stays unencoded.
	handle {
		encode
		reverse_proxy web:3000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}
}

# Web-page artifacts' sandbox (task #544): the web app tells sandbox requests
# apart by Host alone, so this site needs only the app's proxy — no realtime or
# desktop routes. Until coforgeusercontent.com's filing clears this is a
# coforge.cn subdomain; host-only cookies keep it off the app's session.
usercontent.coforge.cn {
	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>X-Coforge-Agent-Api-Key delete
			}
		}
	}

	handle {
		encode
		reverse_proxy web:3000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}
}
