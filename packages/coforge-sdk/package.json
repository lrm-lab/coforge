{
  "name": "@lrm/coforge-sdk",
  "version": "0.1.0",
  "files": [
    "index.ts",
    "src",
    "proto",
    "buf.yaml",
    "buf.gen.yaml",
    "README.md"
  ],
  "type": "module",
  "module": "index.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./agent": "./src/agent/index.ts",
    "./internal": "./src/internal/index.ts",
    "./internal/*": "./src/internal/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "bun ./node_modules/@bufbuild/buf/bin/buf generate",
    "test": "bun test",
    "check": "bun run generate && bun ./node_modules/@bufbuild/buf/bin/buf lint && bun ./node_modules/@bufbuild/buf/bin/buf format --diff --exit-code && oxfmt --check . && oxlint . && tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@types/mdast": "^4.0.4",
    "micromark-util-decode-numeric-character-reference": "^2.0.2",
    "micromark-util-types": "^2.0.3",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@types/bun": "1.4.4",
    "decode-named-character-reference": "^1.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  }
}
