{
  "name": "@lrm/coforge-anvil",
  "version": "0.1.0",
  "type": "module",
  "module": "index.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "check": "oxfmt --check index.ts src test && oxlint src test index.ts && tsc --noEmit",
    "test": "bun test",
    "format": "oxfmt index.ts src test",
    "build": "bun run typecheck"
  },
  "dependencies": {
    "@coforge/agent": "workspace:*",
    "@logtape/logtape": "2.3.2",
    "@lrm/coforge-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
