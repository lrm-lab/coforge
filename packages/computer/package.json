{
  "name": "@coforge/computer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "generate:installer-contract": "bun scripts/installer-contract.ts"
  },
  "dependencies": {
    "@coforge/agent": "workspace:*",
    "@logtape/file": "2.4.2",
    "@logtape/logtape": "2.4.2",
    "@logtape/redaction": "2.4.2",
    "@lrm/coforge": "workspace:*",
    "@lrm/coforge-daemon": "workspace:*",
    "@lrm/coforge-sdk": "workspace:*",
    "commander": "15.1.0",
    "picocolors": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  }
}
