{
  "computer_recovery_gave_up": [
    {
      "declarations": ["input attempts", "local attemptsPlural = attempts: plural"],
      "selectors": ["attemptsPlural"],
      "match": {
        "attemptsPlural=other": "自动恢复在 {attempts} 次尝试后放弃"
      }
    }
  ],
  "computer_recovery_gave_up_message": [
    {
      "declarations": [
        "input attempts",
        "input message",
        "local attemptsPlural = attempts: plural"
      ],
      "selectors": ["attemptsPlural"],
      "match": {
        "attemptsPlural=other": "自动恢复在 {attempts} 次尝试后放弃：{message}"
      }
    }
  ],
  "computer_recovery_restored": [
    {
      "declarations": [
        "input version",
        "input attempts",
        "local attemptsPlural = attempts: plural"
      ],
      "selectors": ["attemptsPlural"],
      "match": {
        "attemptsPlural=other": "自动恢复在 {attempts} 次尝试后将这台 Computer 还原到 {version}"
      }
    }
  ]
}
