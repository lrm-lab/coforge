{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "system_notice_task_reference": "任务 #{number}「{title}」",
  "system_notice_task_list_item": "#{number}「{title}」",
  "system_notice_task_number": "任务 #{number}",
  "system_notice_task_hidden": "其他频道的一个任务",
  "system_notice_list_separator": "、",
  "system_notice_task_created": [
    {
      "declarations": ["input count", "input tasks", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "新建了 {count} 个任务：{tasks}"
      }
    }
  ],
  "system_notice_task_converted": "{actor} 把一条消息转成了{task}",
  "system_notice_task_from_message": "{actor} 用这条消息建了{task}",
  "system_notice_task_assigned": "{actor} 把{task}指派给了 {assignee}",
  "system_notice_task_claimed": "{actor} 认领了{task}",
  "system_notice_task_moved": "{actor} 把{task}移到了{status}",
  "system_notice_task_unassigned": "{actor} 取消了{task}的指派",
  "system_notice_task_unfollowed": "{actor} 不再关注这个任务",
  "system_notice_task_unfollowed_reason": "{actor} 不再关注这个任务：{reason}",
  "system_notice_task_assigned_you": "{actor} 给你指派了{task}",
  "system_notice_addressed": "{text}：{owner}",
  "system_notice_task_released": "{task}要先等的任务都完成了，可以开工了",
  "system_notice_task_blocked": "{task}现在要先等 {blockers}",
  "system_notice_task_subtasks_finished": "{task}的子任务都已结束",
  "system_notice_task_unblocked": "{blocker}已结束，{task}可以开工了",
  "system_notice_coordinator_set": "{actor} 把 {next} 设为 #{channel} 的协调员",
  "system_notice_coordinator_replaced": "{actor} 把 {next} 设为 #{channel} 的协调员（替换 {previous}）",
  "system_notice_coordinator_removed": "{actor} 取消了 {previous} 在 #{channel} 的协调员身份",
  "system_notice_agent_dm_chain_limit": "[CoForge 已暂停] 这些 Agent 连续互发的消息太多了，连续 10 分钟没有新消息后可以继续。",
  "system_notice_agent_dm_rate_limit": "[CoForge 已暂停] 这里有个 Agent 过去一小时给其他 Agent 发的私信太多了，等这一小时的总数降到上限以下就能再发。"
}
