{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "system_notice_task_reference": "任务 #{number}「{title}」",
  "system_notice_task_list_item": "#{number}「{title}」",
  "system_notice_task_number": "任务 #{number}",
  "system_notice_task_hidden": "其他频道的一个任务",
  "system_notice_list_separator": "、",
  "system_notice_task_created": [
    {
      "declarations": ["input count", "input tasks", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "新建了 {count} 个任务：{tasks}"
      }
    }
  ],
  "system_notice_task_converted": "{actor} 把一条消息转成了{task}",
  "system_notice_task_from_message": "{actor} 用这条消息建了{task}",
  "system_notice_task_assigned": "{actor} 把{task}指派给了 {assignee}",
  "system_notice_task_assigned_reason": "{actor} 把{task}指派给了 {assignee}：{reason}",
  "system_notice_task_claimed": "{actor} 认领了{task}",
  "system_notice_task_moved": "{actor} 把{task}移到了{status}",
  "system_notice_task_priority_changed": "{actor} 将{task}的优先级从 {from} 改为 {to}",
  "system_notice_task_unassigned": "{actor} 取消了{task}的指派",
  "system_notice_task_unfollowed": "{actor} 不再关注这个任务",
  "system_notice_task_unfollowed_reason": "{actor} 不再关注这个任务：{reason}",
  "system_notice_task_assigned_you": "{actor} 给你指派了{task}",
  "system_notice_addressed": "{text}：{owner}",
  "system_notice_task_released": "{task}要先等的任务都完成了，可以开工了",
  "system_notice_task_blocked": "{task}现在要先等 {blockers}",
  "system_notice_task_subtasks_finished": "{task}的子任务都已结束",
  "system_notice_task_unblocked": "{blocker}已结束，{task}可以开工了",
  "system_notice_coordinator_set": "{actor} 把 {next} 设为 #{channel} 的协调员",
  "system_notice_coordinator_replaced": "{actor} 把 {next} 设为 #{channel} 的协调员（替换 {previous}）",
  "system_notice_coordinator_removed": "{actor} 取消了 {previous} 在 #{channel} 的协调员身份",
  "system_notice_agent_dm_chain_limit": "[CoForge 已暂停] 这些 Agent 连续互发的消息太多了，连续 10 分钟没有新消息后可以继续。",
  "system_notice_agent_dm_rate_limit": "[CoForge 已暂停] 这里有个 Agent 过去一小时给其他 Agent 发的私信太多了，等这一小时的总数降到上限以下就能再发。",
  "system_notice_member_welcome_requested": "已请 {agent} 欢迎 {newcomer}",
  "system_notice_channel_member_joined": "{members} 加入了频道。",
  "system_notice_channel_member_left": "{members} 离开了频道。",
  "system_notice_channel_member_added": "{actor} 将 {members} 拉进了频道。",
  "system_notice_channel_member_removed": "{actor} 将 {members} 移出了频道。",
  "system_notice_actor_unknown": "有人",
  "system_notice_task_deleted": "{actor} 删除了 {task}",
  "system_notice_task_hidden_deleted": "一个已删除的任务",
  "system_notice_task_due_set": "{actor} 把{task}的截止日期设为 {due}",
  "system_notice_task_due_changed": "{actor} 把{task}的截止日期从 {from} 改为 {to}",
  "system_notice_task_due_removed": "{actor} 去掉了{task}的截止日期",
  "system_notice_task_labels_added": "{actor} 给{task}加了标签 {added}",
  "system_notice_task_labels_removed": "{actor} 去掉了{task}的标签 {removed}",
  "system_notice_task_labels_changed": "{actor} 给{task}加了标签 {added}，去掉了 {removed}",
  "system_notice_task_labels_merged": "合并标签时去掉了{task}的标签 {removed}",
  "system_notice_task_project_set": "{actor} 把{task}放进了项目 {to}",
  "system_notice_task_project_changed": "{actor} 把{task}从项目 {from} 移到了 {to}",
  "system_notice_task_project_removed": "{actor} 把{task}移出了项目 {from}",
  "system_notice_task_parent_set": "{actor} 把{task}设为{to}的子任务",
  "system_notice_task_parent_changed": "{actor} 把{task}的父任务从{from}改为{to}",
  "system_notice_task_parent_removed": "{actor} 让{task}不再是{from}的子任务",
  "system_notice_task_blockers_added": "{actor} 让{task}先等{added}",
  "system_notice_task_blockers_removed": "{actor} 让{task}不用再等{removed}",
  "system_notice_task_blockers_changed": "{actor} 让{task}改为先等{added}，不用再等{removed}",
  "system_notice_task_renamed": "{actor} 把{task}的标题从「{from}」改为「{to}」",
  "system_notice_task_described": "{actor} 更新了{task}的描述",
  "system_notice_task_renamed_described": "{actor} 把{task}的标题从「{from}」改为「{to}」，并更新了描述"
}
