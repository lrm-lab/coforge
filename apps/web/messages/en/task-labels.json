  "labels_settings_archived": "Archived ({count})",
  "labels_settings_task_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} task",
        "countPlural=other": "{count} tasks"
      }
    }
  ],
  "labels_settings_open_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} not finished",
        "countPlural=other": "{count} not finished"
      }
    }
  ],
  "labels_settings_never_used": "Never used",
  "labels_settings_actions": "Actions for {name}",
  "labels_settings_rename": "Rename",
  "labels_settings_rename_field": "New name for {name}",
  "labels_settings_color": "Change color",
