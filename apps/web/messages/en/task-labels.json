  "labels_settings_description_field": "What {name} is for",
  "labels_settings_description_placeholder": "What this label is for",
  "labels_settings_archive": "Archive",
  "labels_settings_archive_title": "Archive “{name}”?",
  "labels_settings_archive_body": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} task uses it. Archived, it is hidden on that task and can’t be put on new ones; restoring it shows it again.",
        "countPlural=other": "{count} tasks use it. Archived, it is hidden on those tasks and can’t be put on new ones; restoring it shows it again."
      }
    }
  ],
  "labels_settings_restore": "Restore",
  "labels_settings_delete": "Delete permanently",
  "labels_settings_delete_title": "Delete “{name}” permanently?",
  "labels_settings_delete_body": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "It comes off {count} task, and this can’t be undone.",
        "countPlural=other": "It comes off {count} tasks, and this can’t be undone."
      }
    }
  ],
  "labels_settings_name_taken": "A label named “{name}” already exists.",
