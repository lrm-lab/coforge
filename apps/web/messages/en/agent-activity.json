    {
      "declarations": [
        "input first",
        "input second",
        "input rest",
        "local restPlural = rest: plural"
      ],
      "selectors": ["restPlural"],
      "match": {
        "restPlural=one": "{first}, {second} and {rest} other agent is replying",
