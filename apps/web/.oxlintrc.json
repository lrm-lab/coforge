{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "jsPlugins": ["./scripts/oxlint-plugin.js"],
  "rules": {
    "coforge/no-native-button": "error",
    "coforge/no-native-select": "error",
    "coforge/no-native-title": "error",
    "coforge/one-avatar": "error",
    "coforge/no-handrolled-toolbar": "warn",
    "coforge/prefer-on-press": "warn"
  }
}
