{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "jsPlugins": ["./scripts/oxlint-plugin.js"],
  "rules": {
    "coforge/no-native-button": "error",
    "coforge/no-native-select": "error",
    "coforge/no-native-title": "error",
    "coforge/one-avatar": "error",
    "coforge/no-handrolled-toolbar": "error",
    "coforge/no-handrolled-resize-handle": "error",
    "coforge/prefer-on-press": "warn",
    "coforge/no-custom-hover-delay": "error",
    "coforge/no-raw-hover-primitives": "error",
    "coforge/no-hover-input-submenu": "error",
    "coforge/no-sync-motion-import": "error",
    "coforge/no-browser-dialogs": "error",
    "coforge/no-raw-toast-library": "error",
    "coforge/no-raw-file-type-icon": "error",
    "coforge/no-distracting-animations": "error",
    "coforge/no-handrolled-date-math": "error",
    "coforge/no-dt-colon": "error",
    "coforge/no-ragged-dl": "error"
  }
}
