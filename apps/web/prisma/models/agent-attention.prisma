model AgentMessageDelivery {
  deliveryId     String       @id @default(uuid(7)) @db.Uuid
  messageId      String       @db.Uuid
  workspaceId    String       @db.Uuid
  conversationId String       @db.Uuid
  agentId        String       @db.Uuid
  taskExecutionSessionId String? @db.Uuid
  sequence       Int
  receivedAt     DateTime?
  /// A tracked @mention's outcome for this Agent: null when the delivery is not tracked, else
  /// "pending", "delivered", "lost" or "unknown" (CHECK in the migration). Delivered and lost are
  /// final; unknown is not.
  mentionOutcome        String?
  /// The daemon's last reported stage ("daemon_received", "daemon_pending", "daemon_drained"),
  /// for diagnosis only (CHECK in the migration).
  mentionStage          String?
  /// Why a lost mention was lost: "quota", "runtime_error", "not_launched" or "unclassified";
  /// set exactly when the outcome is lost (CHECK in the migration).
  mentionReasonCategory String?
  /// The daemon's raw terminal code, kept for diagnosis and never shown.
  mentionTerminalCode   String?
  /// The launch and provider-native session the current envelope was issued for; null while the
  /// delivery went out without one.
  mentionLaunchId       String?
  mentionSessionId      String?
  /// When the outcome became delivered, lost or unknown.
  mentionSettledAt      DateTime?
  /// After this the delivery is stale and no Agent attention read counts it (an app's event past its
  /// expiry); null never expires. Set from the database clock when the delivery is written.
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent          Agent        @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([messageId, agentId])
  @@unique([deliveryId, workspaceId])
  @@index([workspaceId, agentId, receivedAt])
  /// Serves an Agent's channel attention in one target, newest first: a channel message counts for
  /// an Agent only with its delivery row, so the send path's freshness reads walk these rows
  /// instead of the channel's whole history.
  @@index([agentId, conversationId, sequence])
  /// An Agent's still-pending tracked mentions, which a session report, a daemon's ready and a
  /// person's Stop read or settle; every other row stays out of it.
  @@index([workspaceId, agentId], where: { mentionOutcome: "pending" }, map: "agent_message_deliveries_pending_mentions_idx")
  @@map("agent_message_deliveries")
}
