model Task {
  id                           String              @id @default(uuid(7)) @db.Uuid
  /// The message a task started as, in `conversationId`. Null for a task made under task
  /// conversations, which posts no message in the channel; set (and unique) for every earlier task.
  /// A task's `id` is a fresh uuid(7) — `id === messageId` holds only for rows written before
  /// task #507.
  messageId                    String?             @unique @db.Uuid
  conversationId               String              @db.Uuid
  workspaceId                  String              @db.Uuid
  /// The Project this Task is filed under, chosen at creation or by amendment; a conversation
  /// never lends its own (task #484: `projectPinned` and the channel link drop in release 2).
  projectId                    String?             @db.Uuid
  /// Legacy marker from the channel-following model; no longer read or written.
  projectPinned                Boolean             @default(false)
  number                       Int
  title                        String
  description                  String?
  createsResource              Boolean             @default(false)
  resourceReceipt              Json?
  resourceReceiptRecordedAt    DateTime?
  resourceTeardownOwnerAgentId String?             @db.Uuid
  resourceExpiryFollowupId     String?             @db.Uuid
  status                       String              @default("todo")
  revision                     Int                 @default(0)
  ownerMemberId                String?             @db.Uuid
  claimedAt                    DateTime?
  creatorMemberId              String              @db.Uuid
  requestId                    String?             @db.Uuid
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  message                      Message?            @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  conversation                 Conversation        @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace                    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner                        ConversationMember? @relation("TaskOwner", fields: [ownerMemberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Restrict)
  creator                      ConversationMember  @relation("TaskCreator", fields: [creatorMemberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Restrict)
  labels                       TaskLabel[]
  history                      TaskHistoryEvent[]
  executionSessions            TaskExecutionSession[]
  idleReminders                TaskIdleReminder[]
  follows                      TaskFollow[]
  /// The rows naming the Tasks this one waits for, and those naming the Tasks that wait for it
  /// (`TaskDependency`).
  dependencies                 TaskDependency[]    @relation("TaskBlockedBy")
  dependents                   TaskDependency[]    @relation("TaskBlocks")
  /// This Task's parent link when it is a subtask (at most one: `TaskParent.taskId` is its key),
  /// and the links of its own subtasks (`TaskParent`).
  parentLinks                  TaskParent[]        @relation("TaskChild")
  childLinks                   TaskParent[]        @relation("TaskParentOf")
  /// urgent | high | medium | low | none (`TASK_PRIORITIES`); a CHECK holds the five.
  priority                     String              @default("none")
  /// The channel message a task made under task conversations was made from, when it names one.
  /// A message may have several tasks; the message is not the task's.
  sourceMessageId              String?             @db.Uuid
  sourceMessage                Message?            @relation("TaskSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  /// Soft-delete marker: the Task is hidden from boards, lists and Agent reads while set, and
  /// the deleted-task sweep hard-deletes it once it is a minute old (`DELETED_TASK_UNDO_MS`).
  /// `deletedByMemberId` names a channel-member deleter; a Workspace owner/admin acting
  /// without membership carries `deletedByUserId` instead (task #512).
  deletedAt                    DateTime?
  deletedByMemberId            String?             @db.Uuid
  deletedByUserId              String?             @db.Uuid
  /// The task's own conversation (`Conversation.kind` "task_thread"), made by the first reply.
  discussionConversationId     String?             @unique @db.Uuid
  discussion                   Conversation?       @relation("TaskDiscussion", fields: [discussionConversationId], references: [id], onDelete: SetNull)

  @@unique([conversationId, number])
  @@unique([messageId, conversationId])
  @@index([deletedAt], map: "tasks_deletedAt_idx", where: raw("\"deletedAt\" IS NOT NULL"))
  @@unique([id, conversationId])
  @@unique([conversationId, creatorMemberId, requestId])
  @@index([workspaceId, conversationId, status])
  @@index([sourceMessageId, status])
  @@index([workspaceId, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([conversationId, status, updatedAt(sort: Desc), id(sort: Desc)])
  /// Serves an Agent's own Tasks (`task list --mine`) from its member rows, whatever else the
  /// Workspace holds.
  @@index([projectId, status])
  @@index([ownerMemberId, status])
  /// Added for the removed setup checklist's "has this member created a Task"; no query reads it
  /// now. Decide with the migration that drops `setupChecklistDismissedAt` whether the creator
  /// foreign key's delete check still needs it, then drop or keep it.
  @@index([creatorMemberId])
  @@map("tasks")
}

/// Disposable runtime context for one Agent's attempt at one Task. The Agent identity and
/// permissions remain on `Agent`; this record only fences Task execution and retries.
model TaskExecutionSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  taskId         String    @db.Uuid
  conversationId String    @db.Uuid
  workspaceId    String    @db.Uuid
  agentId        String    @db.Uuid
  nativeSessionId String?
  status         String    @default("starting")
  attempt        Int       @default(1)
  requestId      String?   @db.Uuid
  launchId       String?
  lastError      String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  task           Task      @relation(fields: [taskId, conversationId], references: [id, conversationId], onDelete: Cascade)
  agent          Agent     @relation(fields: [agentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([taskId, agentId])
  @@index([agentId, status])
  @@index([workspaceId, status, createdAt])
  @@map("task_execution_sessions")
}

model TaskHistoryEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  taskId        String   @db.Uuid
  seq           Int
  eventType     String
  actorType     String
  /// The actor's handle when the event was recorded (username or Agent name).
  actorName     String?
  /// The event's before/after facts, shaped per eventType (see TaskHistoryEvent in the SDK).
  payload       Json
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, seq])
  @@index([taskId, createdAt])
  @@map("task_history_events")
}

/// An Agent-prepared typed action card (`coforge action prepare`), message-anchored like Task.
/// `payload` stores the resolved, UUID-only action (no handles); a human commits it under their
/// own identity in a follow-up PR, which will set `state`/`committedByUserId`/`committedAt`/`result`.
model ActionCard {
  messageId         String       @id @db.Uuid
  conversationId    String       @db.Uuid
  workspaceId       String       @db.Uuid
  /// channel:create | agent:create | channel:add_member | app:register | app:grant_agent (server-posted) | page:fill
  kind              String
  payload           Json
  draftHint         String?
  preparedByAgentId String       @db.Uuid
  /// pending | executed | cancelled | expired | answered_in_chat
  state             String       @default("pending")
  committedByUserId String?      @db.Uuid
  committedAt       DateTime?
  /// When a still-pending card expires; the sweep writes `expired` and wakes the Agent.
  expiresAt         DateTime?
  /// The asked person's first message that answered this card in chat; the message may be gone.
  answeredInChatMessageId String? @db.Uuid
  answeredInChatAt  DateTime?
  result            Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  message           Message      @relation(fields: [messageId, conversationId], references: [id, conversationId], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  preparedByAgent   Agent        @relation(fields: [preparedByAgentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  committedByUser   User?        @relation(fields: [committedByUserId], references: [id], onDelete: SetNull)

  @@unique([messageId, conversationId])
  @@index([workspaceId, state])
  @@index([state, expiresAt])
  @@map("action_cards")
}

/// A member following a task made under task conversations: its replies wake the member's Agent.
/// Keyed by the task, not a message, because the conversation does not exist until the first
/// reply while following begins when the task is made, claimed or assigned.
model TaskFollow {
  taskId         String             @db.Uuid
  memberId       String             @db.Uuid
  conversationId String             @db.Uuid
  workspaceId    String             @db.Uuid
  /// Why the member follows: created, claimed, assigned, replied, mentioned or manual.
  reason         String
  createdAt      DateTime           @default(now())
  task           Task               @relation(fields: [taskId, conversationId], references: [id, conversationId], onDelete: Cascade)
  member         ConversationMember @relation(fields: [memberId, conversationId, workspaceId], references: [id, conversationId, workspaceId], onDelete: Cascade)

  @@id([memberId, taskId])
  @@index([taskId])
  @@map("task_follows")
}

/// `taskId` waits for `blockedByTaskId`: it may not be claimed until the blocker is done or closed.
/// The two Tasks may be in different conversations of one Workspace; `conversationId` is the
/// dependent's, `workspaceId` is both. TaskBoard keeps them in one Workspace, the graph acyclic and
/// the blocker readable by whoever adds it, under the conversation lock and the Workspace's
/// relation lock. Deleting either Task deletes the row; the other Task survives.
model TaskDependency {
  taskId          String   @db.Uuid
  blockedByTaskId String   @db.Uuid
  conversationId  String   @db.Uuid
  workspaceId     String   @db.Uuid
  /// The conversation member who added the dependency, or the Workspace owner/admin who added
  /// it without a seat (task #524): one of the two is always set, never neither.
  creatorMemberId String?  @db.Uuid
  creatorUserId   String?  @db.Uuid
  createdAt       DateTime @default(now())
  task            Task     @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  blocker         Task     @relation("TaskBlocks", fields: [blockedByTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, blockedByTaskId])
  @@index([blockedByTaskId])
  /// Serves the Workspace-wide read the graph checks make.
  @@index([workspaceId])
  @@map("task_dependencies")
}

/// `taskId` is a subtask of `parentTaskId`; the two may be in different conversations of one
/// Workspace (`conversationId` is the child's). A Task has at most one parent (the primary key).
/// The tree is acyclic and at most five levels deep, checked by TaskBoard under the conversation
/// lock and the Workspace's relation lock. Deleting the parent deletes the link only: its children
/// survive, unparented. Kept apart from `Task` so linking never rewrites a Task row.
model TaskParent {
  taskId         String   @id @db.Uuid
  parentTaskId   String   @db.Uuid
  conversationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  createdAt      DateTime @default(now())
  task           Task     @relation("TaskChild", fields: [taskId], references: [id], onDelete: Cascade)
  parent         Task     @relation("TaskParentOf", fields: [parentTaskId], references: [id], onDelete: Cascade)

  @@index([parentTaskId])
  /// Serves the Workspace-wide read the graph checks and `show`'s subtree make.
  @@index([workspaceId])
  @@map("task_parents")
}

/// One level of label groups: a name and whether a Task may carry one label of it (`single`) or
/// several (`multiple`). A Task never carries two labels of a single group; a group change does not
/// rewrite existing rows, the next label write to a Task enforces it.
model LabelGroup {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  /// `lower(trim(name))`: the name a group is looked up and made unique by.
  nameKey     String
  /// single | multiple
  selection   String   @default("single")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  labels      Label[]

  @@unique([workspaceId, nameKey])
  @@index([workspaceId])
  @@map("label_groups")
}

/// A Workspace-level task label: a display name and one Badge semantic color. The name is unique
/// case-insensitively within the Workspace; any member may create one, only an owner or admin
/// renames, recolors, merges, archives or deletes it.
model Label {
  id              String      @id @default(uuid(7)) @db.Uuid
  workspaceId     String      @db.Uuid
  /// The name as typed; `nameKey` is what uniqueness and lookups use.
  name            String
  /// `lower(trim(name))`: "Bug" and "bug" are one label.
  nameKey         String
  /// One of the Badge semantic color keys, never a hex value.
  color           String      @default("gray")
  /// What the label is for; an Agent must write one when it creates a label, a person may skip it.
  description     String?
  /// The group it belongs to; null when it has none.
  groupId         String?     @db.Uuid
  /// Set while archived: it stays on the Tasks that carry it, but cannot be attached again.
  archivedAt      DateTime?
  createdByUserId String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group           LabelGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tasks           TaskLabel[]

  @@unique([workspaceId, nameKey])
  @@index([workspaceId])
  @@index([groupId])
  @@map("labels")
}

/// One label on one task. At most five per task, checked by the Task write; deleting the task or
/// the label takes these rows with it.
model TaskLabel {
  taskId    String   @db.Uuid
  labelId   String   @db.Uuid
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}
