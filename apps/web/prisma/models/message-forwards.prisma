/// A message forwarded from another conversation: the new message's `body` is the forwarder's
/// note (possibly empty) and its rows here are the snapshots of the originals it carries, in
/// `position` order (one for a single message; several, oldest first, for a selection). Each
/// snapshot is frozen at forward time: `sourceBody` has its mentions and references already read back as
/// plain text, so forwarding notifies nobody the original named, and a later edit or delete of
/// the original changes nothing here. The new message's own attachments are copies of the
/// originals': with one original all of them are its, and with several each copy names its
/// original (`Attachment.forwardPosition`).
model MessageForward {
  /// The new message, in the destination conversation.
  messageId              String   @db.Uuid
  /// This original's place among the ones the message carries, from 0.
  position               Int      @default(0)
  /// The original, until it is deleted; the snapshot then stays and only "open original" goes.
  sourceMessageId        String?  @db.Uuid
  sourceConversationId   String   @db.Uuid
  /// The original's thread root when it was a reply; the "open original" permission check and the
  /// "from #channel · thread" line read it.
  sourceThreadRootId     String?  @db.Uuid
  /// The source conversation as it was named: the channel name, null for a direct conversation.
  sourceConversationName String?
  sourceSenderName       String
  sourceSenderHandle     String
  sourceCreatedAt        DateTime
  sourceBody             String
  /// The original's body as stored, with its `<@kind:...>` tokens, for the card to draw chips from.
  /// `sourceBody` is computed from it and `sourceMentions` in the same step. Null on a forward made
  /// before these columns, which the card draws from `sourceBody`.
  sourceRawBody          String?
  /// The original's mentions as the browser reads them (kind, actorId, handle, label), frozen.
  sourceMentions         Json?
  createdAt              DateTime @default(now())
  /// The Workspace the carrying message belongs to, stamped beside it (denormalized from the
  /// message, which the forward row cascades from): the forward picker's "most forwarded" read
  /// counts a member's forwards from here, without joining messages to find them (task #78).
  /// NOT NULL since release two: the backfill filled the rows a rolling deploy's old instances
  /// wrote without it, and the only writer stamps it from the message (task #93).
  workspaceId            String   @db.Uuid
  /// The person who made the forward — the carrying message's sender's User id, denormalized
  /// from their member row (a member row names a conversation, but the history is the person's).
  /// Null only where the sender was not a person; the picker reads it by equality, so those rows
  /// never surface.
  senderUserId           String?  @db.Uuid
  message                Message  @relation("MessageForwardOf", fields: [messageId], references: [id], onDelete: Cascade)
  sourceMessage          Message? @relation("MessageForwardSource", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@id([messageId, position])
  /// Serves the `SET NULL` when an original is deleted.
  @@index([sourceMessageId])
  /// Serves the forward picker's "most forwarded" order: a person's forwards in one Workspace,
  /// newest first, walked from the index and stopped after the window (task #78).
  @@index([workspaceId, senderUserId, createdAt(sort: Desc)])
  @@map("message_forwards")
}
