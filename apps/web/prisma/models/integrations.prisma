/// Personal integration, never a login identity or shared Workspace credential.
model GitHubConnection {
  userId           String   @id @db.Uuid
  clientId         String
  githubUserId     String
  login            String
  credentials      String?
  expiresAt        DateTime
  refreshExpiresAt DateTime
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, githubUserId])
  @@map("github_connections")
}

/// One outstanding, browser-bound OAuth attempt per User, replaced on a new connect.
model GitHubAuthorization {
  userId    String   @id @db.Uuid
  stateHash String
  verifier  String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_authorizations")
}

/// Cache of a User's usable GitHub App installations, refreshed by GitHubConnection.sync()
/// and kept fresh by installation/installation_repositories webhooks. Read-only for Settings.
model GitHubUserInstallation {
  userId              String   @db.Uuid
  installationId      Int
  accountLogin        String
  repositorySelection String
  suspended           Boolean
  configureUrl        String
  syncedAt            DateTime
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, installationId])
  @@index([installationId])
  @@map("github_user_installations")
}
