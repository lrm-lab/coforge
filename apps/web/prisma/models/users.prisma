model User {
  workspaceAssistantSessions WorkspaceAssistantSession[]
  id                          String                          @id @default(uuid(7)) @db.Uuid
  username                    String                          @unique
  /// The latest email the identity provider reported at login. Not unique and never an identity key.
  email                       String?
  /// Whether the provider says it verified that email (`email_verified`): true when it vouches for
  /// the address, false when it says it does not, null when it has not said (an account that has
  /// not signed in since this was recorded). Recorded, never assumed: a platform operator is
  /// matched only on `true`, so an address anyone can type into their own account cannot claim it.
  emailVerified               Boolean?
  /// The latest phone number the identity provider reported at login, in E.164
  /// (`+8613800138000`). Reported by the provider, not an identity key: it never signs anyone in
  /// and never links two accounts. Null when the provider reports none, or one this platform
  /// cannot use as a code destination.
  phone                       String?
  /// Whether the provider says it verified that number (`phone_number_verified`), on the same
  /// terms as `emailVerified`.
  phoneVerified               Boolean?
  /// The name teammates see. Required, as Slack requires a name: an account starts with the name
  /// its sign-in provider reported (`initialDisplayName`), and a person confirms it at first
  /// sign-in. A person is never shown by `username`.
  displayName                 String
  /// When the person finished first sign-in (confirmed their name and made their Workspace); null
  /// until then, which is what sends them to that step.
  welcomedAt                  DateTime?
  description                 String                          @default("")
  /// An image object key, or `preset:<id>` for a platform picture the app serves itself.
  avatarObjectKey             String?
  avatarContentType           String?
  createdAt                   DateTime                        @default(now())
  preferences                 UserPreference?
  identities                  UserIdentity[]
  gitHubConnection            GitHubConnection?
  gitHubAuthorization         GitHubAuthorization?
  gitHubUserInstallations     GitHubUserInstallation[]
  memberships                 WorkspaceMembership[]
  platformOperator            PlatformOperator?               @relation("PlatformOperatorUser")
  platformOperatorsGranted    PlatformOperator[]              @relation("PlatformOperatorGrantedBy")
  appReviewsRequested         AppReviewRequest[]              @relation("AppReviewRequestedBy")
  appReviewsDecided           AppReviewRequest[]              @relation("AppReviewDecidedBy")
  appShareLinksCreated        AppShareLink[]                  @relation("AppShareLinkCreatedBy")
  pendingMentionActions       PendingMentionAction[]
  createdJoinLinks            WorkspaceJoinLink[]
  agents                      Agent[]                     @relation("AgentOwner")
  deletedAgents               Agent[]                     @relation("AgentDeletedBy")
  weeklyReportAssistants        WeeklyReportAssistant[]
  weeklyReportAssistantChatSessions WeeklyReportAssistantChatSession[]
  weeklyReportCollectorBindings WeeklyReportCollectorBinding[]
  weeklyReportCollectRuns       WeeklyReportCollectRun[]
  agentApiKeys                AgentApiKey[]
  daemonApiKeys               DaemonApiKey[]
  computers                   Computer[]
  requestedHostJobs           HostJob[]
  conversationMembers         ConversationMember[]
  webPushSubscriptions        WebPushSubscription[]
  attachments                 Attachment[]
  deviceAuthorizations        DeviceAuthorization[]
  weeklyReportCyclesCreated   WeeklyReportCycle[]             @relation("WeeklyReportCycleCreator")
  weeklyReportsAuthored       WeeklyReport[]                  @relation("WeeklyReportAuthor")
  weeklyReportFavorites       WeeklyReportFavorite[]
  weeklyTemplateRecipients    WeeklyReportTemplateRecipient[]
  weeklyTemplatesOwned        WeeklyReportTemplate[]          @relation("WeeklyReportTemplateOwner")
  recordNotesAuthored         RecordNote[]                    @relation("RecordNoteAuthor")
  recordCommentsAuthored      RecordComment[]                 @relation("RecordCommentAuthor")
  committedActionCards        ActionCard[]
  requestedAgentMigrations    AgentMigration[]
  createdApps                 App[]
  appInstallations            AppInstallation[]       @relation("AppInstallationInstalledBy")
  appInstallationsApproved    AppInstallation[]       @relation("AppInstallationApprovedBy")
  appBotsGranted              AppInstallationBot[]    @relation("AppInstallationBotGrantedBy")
  oauthAuthorizationCodes     OAuthAuthorizationCode[]
  appConsents                 UserAppConsent[]
  appAgentGrantsGiven         AppAgentGrant[]         @relation("AppAgentGrantGrantedBy")
  appAgentGrantsRevoked       AppAgentGrant[]         @relation("AppAgentGrantRevokedBy")
  appAgentAccessDecisions     AppAgentAccessRequest[]
  appAgentInboundGrantsGiven  AppAgentInboundGrant[]  @relation("AppAgentInboundGrantGrantedBy")
  appAgentInboundGrantsRevoked AppAgentInboundGrant[] @relation("AppAgentInboundGrantRevokedBy")
  appAgentInboundDecisions    AppAgentInboundRequest[] @relation("AppAgentInboundRequestDecidedBy")

  @@map("users")
}

/// One row per user, created on the first saved preference. Every setting is nullable:
/// NULL means "not chosen", and the default lives in code so it can change later.
/// Closed sets are TEXT guarded by CHECK constraints in the migration, not Postgres enums.
model UserPreference {
  userId                      String   @id @db.Uuid
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeZone                    String?
  browserNotificationsEnabled Boolean?
  /// Retired open-mode preference; retained for compatibility and ignored by the application.
  conversationOpenMode        String?
  /// Clock display: 12h or 24h. NULL follows the display language. Display only.
  timeFormat                  String?
  /// The experiments (`server/experiments/`) the user has switched on or off: a sparse key → boolean map.
  /// NULL, or a key never set, reads as off; a key the registry no longer lists is ignored.
  experiments                 Json?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("user_preferences")
}

model WebPushSubscription {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @db.Uuid
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model UserIdentity {
  id              String @id @default(uuid(7)) @db.Uuid
  userId          String @db.Uuid
  provider        String
  providerSubject String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

/// Durable RFC 8628 device grant: approval and polling may hit different replicas or span deploys.
/// Hash both codes: the device code is a bearer credential and the short user code is guessable.
model DeviceAuthorization {
  id             String    @id @default(uuid(7)) @db.Uuid
  deviceCodeHash String    @unique @map("device_code_hash")
  userCodeHash   String    @unique @map("user_code_hash")
  /// Null until a signed-in browser approves this grant; the token is minted for this user.
  userId         String?   @map("user_id") @db.Uuid
  status         String    @default("pending")
  expiresAt      DateTime  @map("expires_at")
  approvedAt     DateTime? @map("approved_at")
  /// Last poll, so a Computer polling faster than the advertised interval gets `slow_down`.
  lastPolledAt   DateTime? @map("last_polled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("device_authorizations")
}
