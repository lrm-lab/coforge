/// A third-party app a Workspace registered in the app registry (`server/apps/`), and an OpenID
/// Connect client of CoForge's authorization server. The built-in Agent Apps (`system.reminder`,
/// `system.cleaner`) are not rows: they are the SDK's `BUILT_IN_APPS`.
model App {
  id               String            @id @default(uuid(7)) @db.Uuid
  /// Chosen at registration (or made from the name, with a random suffix) and never changed:
  /// `^[a-z][a-z0-9-]{2,63}$`, never dotted, so never a built-in app's key. It is the app's OIDC
  /// `client_id`, and the audience of the tokens Agents get for the app.
  key              String            @unique
  /// The Workspace that registered the app; it is installed there.
  ownerWorkspaceId String            @db.Uuid
  name             String
  description      String            @default("")
  /// One line telling an Agent when to use the app, at most 160 characters.
  whenToUse        String            @default("")
  /// An absolute https URL, in canonical form; null when the app gave none.
  homepageUrl      String?
  /// OAuth redirect URIs, matched as exact strings (RFC 9700).
  redirectUris     String[]
  /// What the app is for: `ai-automation`, `communication`, `productivity`, `developer-tools`,
  /// `data-analytics`, `business-ops`, `infrastructure`, `content-creative` or `other`
  /// (`apps_category_check`).
  category         String            @default("other")
  /// Scopes the app may request: always `openid`, `profile` and `identity`, and maybe `email`.
  allowedScopes    String[]
  /// The uploaded logo in the image store (`server/apps/app-logo.server.ts`): the bytes stay there,
  /// and surfaces read `appLogoUrl`. Null shows the monogram made from the name.
  logoObjectKey    String?
  /// The logo's checked image type, served with its bytes; set and cleared with `logoObjectKey`.
  logoContentType  String?
  /// SHA-256 (hex) of the client secret, whose plaintext is shown once.
  clientSecretHash String
  secretRotatedAt  DateTime?
  /// The data the app may read where it is installed (`server/app-permissions/`): any of
  /// `workspace`, `agent`, `channel` and `computer`, read-only, in that order
  /// (`apps_permission_groups_check`). Separate from `allowedScopes`, which are about signing in.
  permissionGroups String[]          @default([])
  /// Goes up by one whenever `permissionGroups` changes, so an approval names what it approved.
  permissionRevision Int             @default(0)
  /// Where an owner or admin continues setting the app up after installing it (`server/app-installation-setup/`):
  /// https, or http on loopback, at most 2000 characters, canonical, no user info or fragment
  /// (`apps_setup_url_check`). Null: the app needs no setup.
  setupUrl         String?
  /// One line telling installers what the setup page is for, at most 500 characters.
  setupDescription String            @default("")
  /// Goes up by one only when `setupUrl` changes (setup turned on or off included), so a
  /// completion names the setup it finished; a change of the description leaves it.
  setupRevision    Int               @default(0)
  createdByUserId  String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ownerWorkspace   Workspace         @relation(fields: [ownerWorkspaceId], references: [id], onDelete: Cascade)
  createdBy        User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  installations    AppInstallation[]
  authorizationCodes OAuthAuthorizationCode[]
  consents         UserAppConsent[]
  agentGrants      AppAgentGrant[]
  agentAccessRequests AppAgentAccessRequest[]

  @@index([ownerWorkspaceId])
  @@index([createdByUserId])
  @@map("apps")
}

/// An app installed in a Workspace. Today only the registering Workspace installs its app; the row
/// is what a later install elsewhere adds.
model AppInstallation {
  id                String    @id @default(uuid(7)) @db.Uuid
  appId             String    @db.Uuid
  workspaceId       String    @db.Uuid
  installedByUserId String?   @db.Uuid
  /// The groups an owner or admin approved, as the app declared them at `approvedRevision`
  /// (`app_installations_approved_groups_check`). The app reads only those it still declares; a
  /// group it stops declaring leaves this list too, so declaring it again needs a new approval.
  approvedGroups    String[]  @default([])
  /// The app's `permissionRevision` that was approved; 0 before any approval.
  approvedRevision  Int       @default(0)
  approvedAt        DateTime?
  approvedByUserId  String?   @db.Uuid
  /// The app's `setupRevision` this installation finished setting up, as the app reported it; null
  /// while it has not (and for a new installation: completion is never inherited).
  setupCompletedRevision Int?
  /// When the app first reported that revision complete; set and cleared with `setupCompletedRevision`
  /// (`app_installations_setup_completion_check`).
  setupCompletedAt  DateTime?
  /// Which Agents may use the app: `all` (the default, every Agent in the Workspace, new ones
  /// included) or `selected` (only those in `agents`; `app_installations_agent_access_check`). A
  /// CoForge extension: Raft has no per-Agent install scope. Switching it revokes no grant.
  agentAccess       String    @default("all")
  createdAt         DateTime  @default(now())
  app               App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installedBy       User?     @relation("AppInstallationInstalledBy", fields: [installedByUserId], references: [id], onDelete: SetNull)
  approvedBy        User?     @relation("AppInstallationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  agents            AppInstallationAgent[]

  @@unique([appId, workspaceId])
  @@index([workspaceId])
  @@index([installedByUserId])
  @@index([approvedByUserId])
  @@map("app_installations")
}
