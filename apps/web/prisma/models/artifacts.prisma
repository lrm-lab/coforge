/// A versioned page or set of files. Its `homeKey` is the only ACL:
/// `conversation:<id>`, `workspace`, or `public`.
model Artifact {
  id              String            @id @default(uuid(7)) @db.Uuid
  workspaceId     String            @db.Uuid
  /// conversation:<conversationId> | workspace | public
  homeKey         String
  /// Unique within its home; the web URL uses a separate short id.
  name            String
  title           String            @default("")
  description     String            @default("")
  /// html | markdown | text | csv | image | pdf | video | other
  kind            String
  entryPath       String
  authorUserId    String?           @db.Uuid
  authorAgentId   String?           @db.Uuid
  currentVersion  Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?           @db.Uuid
  deletedByAgentId String?          @db.Uuid
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions        ArtifactVersion[]

  @@index([workspaceId, homeKey])
  /// The live name is unique per home (`deletedAt IS NULL`), so a soft delete releases it at once.
  /// Built `CONCURRENTLY` by migration 20261103080100; declared here so `migrate diff` keeps it.
  /// Its generated `workspaceId_homeKey_name` selector ignores `deletedAt`: look a live name up with
  /// `findFirst` and `deletedAt: null`, never `findUnique` or `upsert` on it.
  @@unique([workspaceId, homeKey, name], where: { deletedAt: null }, map: "artifacts_home_live_name_key")
  @@map("artifacts")
}

/// One immutable published version. A push sends only changed files; unlisted ones carry over
/// from the base version. `changedPaths` names what this version changed or removed.
model ArtifactVersion {
  id               String         @id @default(uuid(7)) @db.Uuid
  artifactId       String         @db.Uuid
  number           Int
  publisherUserId  String?        @db.Uuid
  publisherAgentId String?        @db.Uuid
  note             String         @default("")
  label            String         @default("")
  entryPath        String
  changedPaths     Json
  merged           Json?
  idempotencyKey   String
  createdAt        DateTime       @default(now())
  artifact         Artifact       @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  files            ArtifactFile[]

  @@unique([artifactId, number])
  @@unique([artifactId, idempotencyKey])
  @@map("artifact_versions")
}

/// One file of one version, by content-addressed blob.
model ArtifactFile {
  versionId  String          @db.Uuid
  artifactId String          @db.Uuid
  path       String
  sha256     String
  sizeBytes  Int
  kind       String
  version    ArtifactVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, path])
  @@index([artifactId, sha256])
  /// The blob sweep's question: does any version still name these bytes?
  @@index([sha256])
  @@map("artifact_files")
}

/// A stored content-addressed blob, shared by every version that uses the same bytes.
model ArtifactBlob {
  workspaceId String    @db.Uuid
  sha256      String
  sizeBytes   Int
  /// `text` (UTF-8 without a NUL) or `binary`, decided by the server from the bytes at upload;
  /// it picks the size limit. A CHECK constraint in the migration holds the two values.
  kind        String
  /// The object holding the bytes (`artifactBlobKey`), one per upload that made this row: the
  /// sweep removes the object of the row it removed, never one a later upload of the same bytes
  /// wrote.
  objectKey   String
  createdAt   DateTime  @default(now())
  /// The last upload of these bytes, or the last save that put them in a version: a blob no
  /// version names is removed a day after it (`StoredArtifactBlobs.removeUnreferenced`). A save
  /// sets it in its transaction, which is also what keeps the sweep off the blob meanwhile.
  lastUsedAt  DateTime  @default(now())
  /// Whether a saved version has named these bytes. Versions are immutable and stay while their
  /// artifact does, so a named blob never becomes unused: the sweep reads only the others
  /// (`artifact_blobs_unused_idx`, a partial index in the migration).
  referenced  Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, sha256])
  @@index([lastUsedAt], map: "artifact_blobs_unused_idx", where: raw("\"referenced\" = false"))
  @@map("artifact_blobs")
}
