/// A versioned page or set of files. Its `homeKey` is the only ACL:
/// `conversation:<id>`, `workspace`, or `public`.
model Artifact {
  id              String            @id @default(uuid(7)) @db.Uuid
  workspaceId     String            @db.Uuid
  /// conversation:<conversationId> | workspace | public
  homeKey         String
  /// The read-access tier: `conversation` keeps reads to the home conversation's readers;
  /// `workspace` widens reads to every Workspace member. Writes never follow the tier.
  /// A workspace-home artifact is always `workspace` (task #529).
  access          String            @default("conversation")
  /// Unique within its home; the web URL uses a separate short id.
  name            String
  title           String            @default("")
  description     String            @default("")
  /// A document's first two lines with text, plain, for its card and list; kept from its
  /// current version (`artifactPreview`). Empty for any other artifact.
  preview         String            @default("")
  /// html | markdown | text | csv | image | pdf | video | other
  kind            String
  entryPath       String
  authorUserId    String?           @db.Uuid
  authorAgentId   String?           @db.Uuid
  /// The client's key for an idempotent create, and a hash of that create's inputs (task #385):
  /// the same key with the same inputs replays this row; the same key with different inputs is a
  /// conflict. Null for an artifact made before this, or by a path that sends no key.
  idempotencyKey  String?
  requestHash     String?
  currentVersion  Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?           @db.Uuid
  deletedByAgentId String?          @db.Uuid
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions        ArtifactVersion[]
  accessEvents    ArtifactAccessEvent[]
  publicLinks     ArtifactPublicLink[]
  readPositions   ArtifactReadPosition[]
  comments        ArtifactComment[]
  commentReviews  ArtifactCommentReview[]
  commentPositions ArtifactCommentPosition[]

  @@index([workspaceId, homeKey])
  /// The live name is unique per home (`deletedAt IS NULL`), so a soft delete releases it at once.
  /// Built `CONCURRENTLY` by migration 20261103080100; declared here so `migrate diff` keeps it.
  /// Its generated `workspaceId_homeKey_name` selector ignores `deletedAt`: look a live name up with
  /// `findFirst` and `deletedAt: null`, never `findUnique` or `upsert` on it.
  @@unique([workspaceId, homeKey, name], where: { deletedAt: null }, map: "artifacts_home_live_name_key")
  /// An idempotent create's key is unique per Workspace among live artifacts, so a retried create
  /// returns the one it already made instead of a second. Built `CONCURRENTLY` by migration
  /// 20261104160100; declared here so `migrate diff` keeps it. Its generated
  /// `workspaceId_idempotencyKey` selector ignores the partial predicate: look it up with
  /// `findFirst` and `deletedAt: null`, never `findUnique` or `upsert`.
  @@unique([workspaceId, idempotencyKey], where: { idempotencyKey: { not: null }, deletedAt: null }, map: "artifacts_idempotency_key")
  @@map("artifacts")
}

/// Audit trail for an artifact's "anyone with the link" share. Only one row may be live.
model ArtifactPublicLink {
  id              String    @id @default(uuid(7)) @db.Uuid
  artifactId      String    @db.Uuid
  token           String
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?   @db.Uuid
  artifact        Artifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@unique([artifactId], where: { revokedAt: null }, map: "artifact_public_links_live_key")
  @@index([artifactId, revokedAt])
  @@map("artifact_public_links")
}

/// One immutable published version. A push sends only changed files; unlisted ones carry over
/// from the base version. `changedPaths` names what this version changed or removed.
model ArtifactVersion {
  id               String         @id @default(uuid(7)) @db.Uuid
  artifactId       String         @db.Uuid
  number           Int
  publisherUserId  String?        @db.Uuid
  publisherAgentId String?        @db.Uuid
  note             String         @default("")
  label            String         @default("")
  entryPath        String
  /// The artifact's title and description as this version left them: a save over an older
  /// version merges them item by item against its base's (`mergeSettings`).
  title            String         @default("")
  description      String         @default("")
  changedPaths     Json
  /// What this version took from others' saves since its base: `{ files: paths, settings: names }`;
  /// null when it took nothing.
  merged           Json?
  /// The version this one went back to (`Artifacts.revert`): its content saved again as a new
  /// version. Null for an ordinary save.
  revertedFrom     Int?
  idempotencyKey   String
  createdAt        DateTime       @default(now())
  artifact         Artifact       @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  files            ArtifactFile[]

  @@unique([artifactId, number])
  @@unique([artifactId, idempotencyKey])
  @@map("artifact_versions")
}

/// One access-tier change (task #529): who moved the artifact from which tier to which, and
/// when. Content history stays in `ArtifactVersion`; an access change is not a version.
model ArtifactAccessEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  artifactId   String   @db.Uuid
  actorUserId  String?  @db.Uuid
  actorAgentId String?  @db.Uuid
  /// The tier before and after: conversation | workspace
  from         String
  to           String
  createdAt    DateTime @default(now())
  artifact     Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, createdAt])
  @@map("artifact_access_events")
}

/// One file of one version, by content-addressed blob.
model ArtifactFile {
  versionId  String          @db.Uuid
  artifactId String          @db.Uuid
  path       String
  sha256     String
  sizeBytes  Int
  kind       String
  version    ArtifactVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, path])
  @@index([artifactId, sha256])
  /// The blob sweep's question: does any version still name these bytes?
  @@index([sha256])
  @@map("artifact_files")
}

/// A stored content-addressed blob, shared by every version that uses the same bytes.
model ArtifactBlob {
  workspaceId String    @db.Uuid
  sha256      String
  sizeBytes   Int
  /// `text` (UTF-8 without a NUL) or `binary`, decided by the server from the bytes at upload;
  /// it picks the size limit. A CHECK constraint in the migration holds the two values.
  kind        String
  /// The object holding the bytes (`artifactBlobKey`), one per upload that made this row: the
  /// sweep removes the object of the row it removed, never one a later upload of the same bytes
  /// wrote.
  objectKey   String
  createdAt   DateTime  @default(now())
  /// The last upload of these bytes, or the last save that put them in a version: a blob no
  /// version names is removed a day after it (`StoredArtifactBlobs.removeUnreferenced`). A save
  /// sets it in its transaction, which is also what keeps the sweep off the blob meanwhile.
  lastUsedAt  DateTime  @default(now())
  /// Whether a saved version has named these bytes. Versions are immutable and stay while their
  /// artifact does, so a named blob never becomes unused: the sweep reads only the others
  /// (`artifact_blobs_unused_idx`, a partial index in the migration).
  referenced  Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  grants      ArtifactBlobGrant[]

  @@id([workspaceId, sha256])
  @@index([lastUsedAt], map: "artifact_blobs_unused_idx", where: raw("\"referenced\" = false"))
  @@map("artifact_blobs")
}

/// Who may name a stored blob in a save: whoever uploaded those bytes (`user:<id>` or
/// `agent:<id>`). A save may name only bytes its publisher uploaded or its artifact already uses,
/// so a hash learned from a home the publisher cannot read does not copy its bytes into one it
/// can write. Goes with the blob.
model ArtifactBlobGrant {
  workspaceId String       @db.Uuid
  sha256      String
  actorKey    String
  createdAt   DateTime     @default(now())
  blob        ArtifactBlob @relation(fields: [workspaceId, sha256], references: [workspaceId, sha256], onDelete: Cascade, map: "artifact_blob_grants_blob_fkey")

  @@id([workspaceId, sha256, actorKey])
  @@map("artifact_blob_grants")
}

/// The newest version of an artifact an Agent has seen, by reading its current version or by
/// publishing one. It only moves forward (`advanceReadPosition` writes only a greater value), so a
/// read that raced a newer one cannot rewind it. `agentId` has no foreign key: this module adds
/// none to a table outside it. Goes with the artifact.
model ArtifactReadPosition {
  artifactId String   @db.Uuid
  agentId    String   @db.Uuid
  version    Int
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([artifactId, agentId])
  @@map("artifact_read_positions")
}

/// The last comment (`seenAt`, `seenId`, the order comments are listed in) an Agent was shown by the
/// unfiltered unseen read of an artifact's comments; it moves only forward (`advanceCommentPosition`
/// writes only a later one). It is not the version position (`ArtifactReadPosition`): an Agent's
/// own push marks the versions it made as seen and nobody's comments. No row: the Agent has seen no
/// comment. `seenAt` has the precision of `ArtifactComment.createdAt`, so the pair compares
/// exactly. `agentId` has no foreign key: this module adds none to a table outside it. Goes with
/// the artifact.
model ArtifactCommentPosition {
  artifactId String   @db.Uuid
  agentId    String   @db.Uuid
  seenAt     DateTime
  seenId     String   @db.Uuid
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([artifactId, agentId])
  @@map("artifact_comment_positions")
}

/// One comment on an artifact: about the whole artifact, or about a file (`path`) and a place in
/// it (`anchor`, `{ type, data }`, `data` at most 4 KiB). `version` is the version it was written
/// on. A reply has `rootId`, the thread's first comment (never another reply), so a thread is
/// every row with that `rootId` and the root itself; a root is `resolved` by `resolvedAt` and
/// reopened by clearing it, and a reply to a resolved thread reopens it. The author is exactly one
/// of `authorUserId` and `authorAgentId`, with no foreign key: this module adds none to a table
/// outside it. A deleted comment keeps its row and loses its text at the reader (`deletedAt`).
/// Comments are listed oldest first by (`createdAt`, `id`); a write holds the artifact's advisory
/// lock and stamps `createdAt` after taking it, so commit order and that order agree. An Agent's
/// retry names its `idempotencyKey`: the same key and `requestHash` replay the comment. A thread
/// and a review go with the artifact.
model ArtifactComment {
  id                String                 @id @default(uuid(7)) @db.Uuid
  artifactId        String                 @db.Uuid
  version           Int
  path              String?
  anchor            Json?
  rootId            String?                @db.Uuid
  reviewId          String?                @db.Uuid
  authorUserId      String?                @db.Uuid
  authorAgentId     String?                @db.Uuid
  body              String
  idempotencyKey    String?
  requestHash       String?
  createdAt         DateTime               @default(now())
  editedAt          DateTime?
  deletedAt         DateTime?
  resolvedAt        DateTime?
  resolvedByUserId  String?                @db.Uuid
  resolvedByAgentId String?                @db.Uuid
  artifact          Artifact               @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  root              ArtifactComment?       @relation("ArtifactCommentThread", fields: [rootId], references: [id], onDelete: Cascade)
  replies           ArtifactComment[]      @relation("ArtifactCommentThread")
  review            ArtifactCommentReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  /// A key is unique per artifact and author; a null author column never collides.
  @@unique([artifactId, authorAgentId, idempotencyKey])
  @@unique([artifactId, authorUserId, idempotencyKey])
  /// An artifact's comments oldest first, and the unseen ones after a position.
  @@index([artifactId, createdAt, id])
  /// One file's comments.
  @@index([artifactId, path])
  /// A thread.
  @@index([rootId])
  /// A review's comments.
  @@index([reviewId])
  @@map("artifact_comments")
}

/// Several comments written at once: one `body` of summary (optional) over comments that all
/// landed together or not at all. `idempotencyKey` and `requestHash` replay a retry, as a
/// version's key does; a key is unique per artifact and author. Goes with the artifact.
model ArtifactCommentReview {
  id             String            @id @default(uuid(7)) @db.Uuid
  artifactId     String            @db.Uuid
  version        Int
  authorUserId   String?           @db.Uuid
  authorAgentId  String?           @db.Uuid
  body           String?
  idempotencyKey String
  requestHash    String
  createdAt      DateTime          @default(now())
  artifact       Artifact          @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  comments       ArtifactComment[]

  @@unique([artifactId, authorAgentId, idempotencyKey])
  @@unique([artifactId, authorUserId, idempotencyKey])
  @@map("artifact_comment_reviews")
}
