# Files no agent writes (linguist-generated): lockfiles and generated code.
# The pre-commit file size check (docs/agents/git-hooks.md) skips them; GitHub leaves them out of
# language statistics and suppresses them in diffs. Mark a file only if it is genuinely generated.
# A pattern without a slash matches that file name in every directory.

# Lockfiles
bun.lock linguist-generated
Cargo.lock linguist-generated
mise.lock linguist-generated
skills-lock.json linguist-generated
crates/installer/contract/lock.json linguist-generated

# Generated code
apps/web/src/routeTree.gen.ts linguist-generated
*.generated.ts linguist-generated

# Hooks run as `#!/bin/sh` scripts; keep them LF even where core.autocrlf=true (Git for Windows)
.githooks/* text eol=lf
