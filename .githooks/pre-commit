#!/bin/sh
# CoForge pre-commit hook: runs the hard rules on the commit being made
# (scripts/ci/hard-rules.ts --staged): the 5,000-token file size ratchet, Markdown links, new
# suppressions and the author identity; see docs/agents/git-hooks.md.
# `bun install` enables it (core.hooksPath=.githooks); `git commit --no-verify` skips it.
# Git runs this from the top of the work tree being committed, which is where the checker
# reads the index from, so the script is located from this file instead.
hooks_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 1
scripts="$hooks_dir/../scripts"

if command -v bun >/dev/null 2>&1; then
  bun_path=bun
elif command -v mise >/dev/null 2>&1; then
  bun_path=$(CDPATH='' cd -- "$hooks_dir/.." && mise which bun 2>/dev/null) || bun_path=
fi
if [ -z "${bun_path:-}" ]; then
  echo "pre-commit: bun was not found, so the hard rules cannot run." >&2
  echo "Install the toolchain (mise install), or bypass the checks once with git commit --no-verify." >&2
  exit 1
fi
exec "$bun_path" "$scripts/ci/hard-rules.ts" --staged
