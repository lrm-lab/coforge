# mise binary digests for the credential-bearing workflow jobs (task #714).
#
# MISE_VERSION is the single version pin read by
# scripts/ci/workflow-mise-cache.test.ts, which fails if any workflow's
# `version:` input drifts from it. Bump the version here and in every
# workflow `version:` input together, then regenerate the SHA256_* values
# with:
#
#   bun scripts/ci/mise-digests.ts
#
# SHA256_<OS>_<ARCH> is the sha256 of the `mise` executable the runner
# installs for that target — the same bytes as the raw release asset
# `mise-v<version>-<target>[.exe]`, whose hash is published in the release's
# minisign-verified SHASUMS256.txt. SHA256_<OS>_<ARCH>_SHIM covers `mise-shim.exe`,
# which only the Windows archives ship.
MISE_VERSION=2026.9.2
SHA256_LINUX_X64=2950f8e1c59f3d9716bc3ee7d9242de94f9ab4054d97e65e12f2e67867c5f8fd
SHA256_LINUX_ARM64=2cea9423c16afa5e1f90646c35ebb3bc8d4647671a605d5856eb96dbbbf87e47
SHA256_MACOS_X64=8860b0de942f3a7c782ae0bafcd5474d78f20ce989846713ee57cf757b6faa08
SHA256_MACOS_ARM64=ed2ea8c994d98d0bfdc214d19c7351fb5bb506164dc368840bd09992d1bd07c5
SHA256_WINDOWS_X64=8a03fe2f169a215acbff3311098c89fb13f170a606b41c27e507467cde62e683
SHA256_WINDOWS_X64_SHIM=0097193b65bfc082e3fd8bde911a60ad4fc81536d66649ed3b305642c755a62d
SHA256_WINDOWS_ARM64=8f2ac6fb63035d46465fdb8e962f5c02120e2ba1004c46aad7763fdc68c267c8
SHA256_WINDOWS_ARM64_SHIM=f0eb02a137b672c6518b78f9f9c277e93c29363f6942a9ffab143fa6a046a12f
