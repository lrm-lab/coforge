BUN_SHA256_MACOS_ARM64=0a2237cdcfa0d16ef501d9acca9f0026309ef348bea7393a64e8d1e3609565cc
BUN_SHA256_WINDOWS_X64=cb1d8e6564e655e49d30cead359750a1cbbd12f42651caa4b62244d7bd93c244
